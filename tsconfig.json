{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "paths": {
      "@RmmzPluginSchema/rmmz/*": ["./src/rmmz/*"],
      "@RmmzPluginSchema/fileio/*": ["./src/fileio/*"],

      "@RmmzPluginSchema/libs/*": ["./src/libs/*"]
    },
    "types": ["node"]
  },

  "include": ["./src/**/*"],
  "exclude": ["node_modules", ".vscode"]
}
